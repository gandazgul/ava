---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AVA Stamford Affordability Demo",
  description = "A Stamford renter affordability workflow for real estate agents."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="app-header">
      <a class="brand" href="/" aria-label="AVA home">
        <span class="brand-mark">AVA</span>
        <span>
          <strong>Agent Value Add</strong>
          <small>Stamford renter fit</small>
        </span>
      </a>
      <nav class="app-nav" aria-label="Workspace">
        <button class="nav-button" type="button" data-nav-view="calculator" aria-pressed="true">Calculator</button>
        <button class="nav-button" type="button" data-nav-view="clients" aria-pressed="false">Client list</button>
        <button class="nav-button" type="button" data-nav-view="properties" aria-pressed="false">Property list</button>
      </nav>
      <button class="ghost-button" type="button" data-open-preview>Upgrade</button>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
