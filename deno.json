{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:astro dev --host 0.0.0.0",
    "build": "deno run -A npm:astro build",
    "check": "deno run -A npm:astro check",
    "test": "deno test --allow-read"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.15"
  }
}
